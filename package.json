{
  "name": "netcard-manager",
  "version": "1.0.0",
  "description": "Professional MikroTik Card Generator & Manager for Desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "copy-wasm": "node -e \"const fs=require('fs'); fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'dist-electron/sql-wasm.wasm');\"",
    "build": "tsc && vite build && npm run copy-wasm",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmed-anis-rowaished/NetCard-Manager.git"
  },
  "keywords": [
    "mikrotik",
    "routeros",
    "card-manager",
    "hotspot",
    "usermanager",
    "pppoe",
    "electron",
    "react",
    "vite"
  ],
  "author": "NetCard Architect",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.11",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.453.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.8.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.netcard.manager",
    "productName": "NetCard Manager",
    "copyright": "Copyright © 2026 NetCard Architect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetCard Manager",
      "runAfterFinish": true
    }
  }
}
